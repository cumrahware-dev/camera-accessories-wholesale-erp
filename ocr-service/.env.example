# Required. Shared secret the ERP sends in the X-API-Key header.
OCR_API_KEY=
OCR_MAX_UPLOAD_MB=15
OCR_TIMEOUT_SECONDS=120
OCR_MAX_PAGES=20
# OCR jobs running at once. Keep 1 on a small server; extra requests wait (up to OCR_MAX_QUEUE) then get HTTP 429.
OCR_MAX_CONCURRENCY=1
OCR_MAX_QUEUE=4
# Tesseract languages, '+' separated. Only these language files are loaded. Install them first (tesseract-ocr-<lang>).
OCR_LANGS=eng
# Render DPI for scanned PDF pages and the longest image side ever passed to Tesseract (larger inputs are downscaled)
OCR_RENDER_DPI=200
OCR_MAX_IMAGE_SIDE=3200
OCR_MAX_IMAGE_MPIXELS=40
# Leave empty: the ERP calls this service server-to-server. Only list origins if a browser must call it.
OCR_ALLOWED_ORIGINS=
