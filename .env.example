# ==============================================================================
# CAMERA & ACCESSORIES WHOLESALE ERP - ENVIRONMENT CONFIGURATION
# Copy this file to `.env` before running the application:
#   Windows: copy .env.example .env
#   macOS/Linux: cp .env.example .env
# ==============================================================================

# Database Configuration (PostgreSQL Connection String)
# Supported: Local PostgreSQL, Supabase, Neon, AWS RDS, Docker
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://postgres.[project-id]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-id]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Cloudinary Storage Configuration (Product Images, Document Attachments, OCR originals)
# These are read by the Next.js SERVER only (all uploads happen there). Set them in the service that runs
# Next.js (e.g. Vercel Project -> Settings -> Environment Variables) and REDEPLOY afterwards. The Render OCR
# service does not need them. Never prefix the secret with NEXT_PUBLIC_. Do not wrap values in quotes.
# Alternative to the three variables below:  CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Check it: sign in as Super Admin, open /api/cloudinary/health?upload=1
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Application Branding & Default Localization
NEXT_PUBLIC_APP_NAME="ARIB GLOBAL Wholesale ERP"
NEXT_PUBLIC_DEFAULT_CURRENCY="USD"
NEXT_PUBLIC_DEFAULT_CURRENCY_SYMBOL="$"

# OCR microservice (ocr-service/, FastAPI + Tesseract 5, CPU only). Server-side only - never NEXT_PUBLIC_.
OCR_API_URL=http://localhost:8001
OCR_API_KEY=
# Optional: ERP-side timeout for one OCR request in ms (default 130000)
# Optional: OCR jobs the ERP runs at once (default 1 - keep it at 1 on a small server)
OCR_MAX_CONCURRENT_JOBS=1
OCR_TIMEOUT_MS=130000
# Original OCR uploads: stored in Cloudinary when CLOUDINARY_* is set, otherwise in this local folder (dev only;
# on serverless hosts you MUST configure Cloudinary because local disk is ephemeral).
# OCR_LOCAL_STORAGE_DIR=./.ocr-files

# Required in production: secret used to sign login sessions (the app refuses to start sessions without it)
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Public address of the ERP, used for every link that leaves the app (emails, customer invoice links). Server-side only.
# Production: APP_BASE_URL=https://erp.aribglobal.com   (required: in production, links are not generated without it, and
# a localhost or non-https value is refused). Local development: leave empty (http://localhost:3000) or set it to your dev URL.
# Older deployments may still have APP_URL / NEXT_PUBLIC_APP_URL; APP_BASE_URL takes precedence.
APP_BASE_URL=

# SMTP mail (invoice / proforma / service-invoice emails and the internal notifications). Server-side only.
# This file is committed: keep it free of real credentials. Set the real values on the server only.
# Leave SMTP_USER/SMTP_PASS empty to run in simulation mode (emails are only logged, never delivered).
# Gmail: SMTP_HOST=smtp.gmail.com with SMTP_PORT=587 (STARTTLS) or 465 (implicit TLS), and an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# ssl / true = implicit TLS (port 465). starttls / false = upgrade on a plain connection (port 587).
# Leave empty to follow the port, which is also what happens for any other value.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="ARIB GLOBAL"
SMTP_FROM=

# Automatic OCR health check interval in minutes (default 10)

# Depot access codes are stored only as a keyed hash. This secret is the key: keep it private and DO NOT change it
# afterwards, or every existing depot code stops working (you would then regenerate them). Falls back to NEXTAUTH_SECRET.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_CODE_PEPPER=
